; Engine configuration file.
; This project is a small Godot 4 probe for loading harness build JSON and
; sending that structured context to an OpenAI-compatible chat endpoint.

config_version=5

[application]

config/name="Idlez Godot AI Bridge"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="mobile"
